generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id          String       @id @default(cuid())
  name        String
  email       String       @unique
  password    String
  image       String?
  role        String       @default("USER")
  createdAt   DateTime     @default(now())
  comments    Comment[]
  forumPosts  ForumPost[]
  likes       Like[]
  uploads     Upload[]
  uploadLikes UploadLike[]
  badges      UserBadge[]
}

model Upload {
  id          String       @id @default(cuid())
  userId      String
  imageUrl    String
  location    String
  description String
  treeType    String
  status      String       @default("PENDING")
  createdAt   DateTime     @default(now())
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes       UploadLike[]
}

model Badge {
  id          String      @id @default(cuid())
  name        String      @unique
  icon        String
  description String
  threshold   Int
  users       UserBadge[]
}

model UserBadge {
  id       String   @id @default(cuid())
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())
  badge    Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
}

model ForumPost {
  id        String    @id @default(cuid())
  userId    String
  title     String
  content   String
  category  String
  createdAt DateTime  @default(now())
  comments  Comment[]
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes     Like[]
}

model Comment {
  id        String    @id @default(cuid())
  userId    String
  postId    String
  content   String
  createdAt DateTime  @default(now())
  post      ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Like {
  id     String    @id @default(cuid())
  userId String
  postId String
  post   ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
}

model UploadLike {
  id       String @id @default(cuid())
  userId   String
  uploadId String
  upload   Upload @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, uploadId])
}
